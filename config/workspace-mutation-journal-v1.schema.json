        "terminal_at": "2026-09-04T15:03:11.492Z",
        "elapsed_ms": 372
      },
      "termination_reason": "turn_completed",
      "operation_count": 3,
      "completed_sequences": [1, 2, 3],
      "coverage": {
        "level": "typed_tools_only",
        "included_tools": ["write_file", "edit_file", "delete_file", "move_file"],
        "excluded_mutation_classes": ["run_command", "explorer_rename"],
        "known_unjournaled_events": [],
        "partially_undoable": false,
        "warning": "Shell mutations are not journaled. Explorer rename is not journaled until WO-27 item 2."
      },
      "retention": {
        "protected": true,
        "reserved_bytes": 9,
        "reserved_entries": 1,
        "referenced_object_ids": ["trash:20260904T150311.401Z:inbox/old.txt"],
        "created_active_use_seconds": 864000,
        "last_accessed_active_use_seconds": 864000,
        "active_age_seconds": 0,
        "wall_clock_review_due_at": "2027-09-04T15:03:11.120Z",
        "wall_clock_review_presented_at": null,
        "pinned_as_newest_committed": true
      },
      "restore": {
        "status": "not_requested",
        "requested_at": null,
        "updated_at": null,
        "completed_at": null,
        "completed_inverse_step_ids": [],
        "decisions": [],
        "staging_entries": [],
        "protected_occupants": [],
        "partial_result": null
      },
      "operations": [
        {
          "sequence": 1,
          "status": "applied",
          "kind": "move",
          "tool_name": "move_file",
          "tool_call_id": "call_move_a",
          "observed_at": "2026-09-04T15:03:11.205Z",
          "source": {
            "relative_path": "inbox/a.txt",
            "pre_signature": { "kind": "file", "byte_size": 5, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
            "post_signature": { "kind": "missing", "byte_size": 0, "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" }
          },
          "destination": {
            "relative_path": "docs/a.txt",
            "pre_signature": { "kind": "missing", "byte_size": 0, "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" },
            "post_signature": { "kind": "file", "byte_size": 5, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }
          },
          "created_parent_paths": ["docs"],
          "recovery_objects": [],
          "inverse_steps": [
            {
              "step_id": "1.1",
