{
  "contract": "PluginManifestV6", "contract_version": 6, "frozen": true,
  "defs": {
    "contribution": {
      "type": "object", "required": ["kind", "contribution_id", "name", "content_path", "content_sha256"], "max_keys": 17, "additional_properties": "reject",
      "properties": {
        "kind": { "type": "enum", "values": ["skill", "prompt", "theme", "settings_schema", "command", "workflow", "mcp_descriptor", "restricted_transform", "restricted_formatter", "restricted_renderer", "restricted_compute", "setup_scene", "panel", "artifact_renderer", "provider_descriptor", "native_mcp", "session_provider", "engine_adapter", "hook"] },
        "contribution_id": { "type": "ref", "ref": "contribution_id" },
        "name": { "type": "ref", "ref": "display_string" },
        "content_path": { "type": "ref", "ref": "asset_path" },
        "content_sha256": { "type": "ref", "ref": "sha256_hex" },
        "component_path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}\\.wasm$", "max_utf8_bytes": 240 },
        "component_sha256": { "type": "ref", "ref": "sha256_hex" },
        "abi_world": { "type": "string", "pattern": "^jenny:plugin/restricted-host@1\\.0\\.0$", "max_utf8_bytes": 40 },
        "executable_path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}\\.(exe|bin)$", "max_utf8_bytes": 240 },
        "executable_sha256": { "type": "ref", "ref": "sha256_hex" },
        "executable_bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "platform": { "type": "ref", "ref": "platform" },
        "architecture": { "type": "ref", "ref": "architecture" },
        "adapter_id": { "type": "ref", "ref": "bounded_id" },
        "server_id": { "type": "ref", "ref": "bounded_id" },
        "hook_event": { "type": "enum", "values": ["plugin.enabled", "plugin.disabled", "plugin.updated", "plugin.uninstalled"] },
        "containment_profile": { "type": "enum", "values": ["windows_job_supervised_v1", "posix_group_supervised_v1"] },
        "resource_class": { "type": "enum", "values": ["interactive", "background"] },
        "replay_safe": { "type": "boolean" },
        "secret_delivery": { "type": "boolean" }
      }
    },
    "dependency": {
      "type": "object", "required": ["kind", "publisher_id", "plugin_id", "version_range"], "max_keys": 4, "additional_properties": "reject",
      "properties": { "kind": { "type": "enum", "values": ["required", "peer", "optional"] }, "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "version_range": { "type": "ref", "ref": "semver_range" } }
    }
  },
  "root": {
    "type": "object", "required": ["manifest_schema_version", "publisher_id", "plugin_id", "name", "version", "contract_versions", "contributions", "dependencies", "requested_permissions"], "max_keys": 9, "additional_properties": "reject",
    "properties": {
      "manifest_schema_version": { "type": "const", "value": 6 }, "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "name": { "type": "ref", "ref": "display_string" }, "version": { "type": "string", "format": "semver" },
      "contract_versions": { "type": "object", "required": ["manifest", "generation", "runtime_snapshot", "full_host_content", "full_host_attestation", "full_host_health", "full_host_termination_receipt", "native_mcp_binding", "engine_adapter", "hook_descriptor", "secret_delivery_grant", "containment_profile", "runtime_attestation"], "max_keys": 13, "additional_properties": "reject", "properties": { "manifest": { "type": "const", "value": 6 }, "generation": { "type": "const", "value": 6 }, "runtime_snapshot": { "type": "const", "value": 6 }, "full_host_content": { "type": "const", "value": 6 }, "full_host_attestation": { "type": "const", "value": 6 }, "full_host_health": { "type": "const", "value": 6 }, "full_host_termination_receipt": { "type": "const", "value": 6 }, "native_mcp_binding": { "type": "const", "value": 6 }, "engine_adapter": { "type": "const", "value": 6 }, "hook_descriptor": { "type": "const", "value": 6 }, "secret_delivery_grant": { "type": "const", "value": 6 }, "containment_profile": { "type": "const", "value": 6 }, "runtime_attestation": { "type": "const", "value": 6 } } },
      "contributions": { "type": "array", "max_items": 32, "unique_by": ["contribution_id"], "items": { "type": "ref", "ref": "contribution" } },
      "dependencies": { "type": "array", "max_items": 16, "unique_by": ["publisher_id", "plugin_id"], "items": { "type": "ref", "ref": "dependency" } },
      "requested_permissions": { "type": "array", "max_items": 10, "unique_by": [], "items": { "type": "enum", "values": ["network.remote_mcp", "network.restricted_runtime", "network.fetch", "ui.view", "secret.brokered_use", "runtime.full_host", "runtime.native_mcp", "runtime.engine_adapter", "runtime.hook", "secret.value_delivery"] } }
    }
  }
}
