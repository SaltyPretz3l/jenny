{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jenny.local/schemas/plugins/catalog-entry-v1.schema.json",
  "title": "Jenny plugin catalog entry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_entry_schema_version", "source_id", "publisher_id", "plugin_id", "display_name", "version", "summary", "package_size_bytes", "package_sha256", "target_path"],
  "properties": {
    "catalog_entry_schema_version": { "const": 1 },
    "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "publisher_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "plugin_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "maxLength": 64 },
    "summary": { "type": "string", "maxLength": 512 },
    "package_size_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
    "package_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_path": { "type": "string", "minLength": 1, "maxLength": 1024 }
  }
}
