{
  "contract": "PluginManifestV2", "contract_version": 2, "frozen": true,
  "defs": {
    "contribution": {
      "type": "object", "required": ["kind", "contribution_id", "name", "content_path", "content_sha256"], "max_keys": 5, "additional_properties": "reject",
      "properties": {
        "kind": { "type": "enum", "values": ["skill", "prompt", "theme", "settings_schema", "command", "workflow", "mcp_descriptor"] },
        "contribution_id": { "type": "ref", "ref": "contribution_id" }, "name": { "type": "ref", "ref": "display_string" },
        "content_path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$", "max_utf8_bytes": 240 }, "content_sha256": { "type": "ref", "ref": "sha256_hex" }
      }
    }
  },
  "root": {
    "type": "object", "required": ["manifest_schema_version", "publisher_id", "plugin_id", "name", "version", "contract_versions", "contributions", "requested_permissions"], "max_keys": 8, "additional_properties": "reject",
    "properties": {
      "manifest_schema_version": { "type": "const", "value": 2 }, "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "name": { "type": "ref", "ref": "display_string" }, "version": { "type": "string", "format": "semver" },
      "contract_versions": {
        "type": "object", "required": ["manifest", "declarative_content", "operation_receipt", "cleanup_state"], "max_keys": 7, "additional_properties": "ignore",
        "properties": { "manifest": { "type": "const", "value": 2 }, "declarative_content": { "type": "const", "value": 2 }, "operation_receipt": { "type": "const", "value": 1 }, "cleanup_state": { "type": "const", "value": 1 } }
      },
      "contributions": { "type": "array", "max_items": 32, "unique_by": ["contribution_id"], "items": { "type": "ref", "ref": "contribution" } },
      "requested_permissions": { "type": "array", "max_items": 0, "items": { "type": "string", "max_utf8_bytes": 64 } }
    }
  }
}
