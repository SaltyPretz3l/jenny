{
  "contract": "PluginRuntimeSnapshotV2", "contract_version": 2, "frozen": true,
  "defs": {
    "item": {
      "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "artifact_digest", "content_digest", "content_schema_version"], "max_keys": 6, "additional_properties": "reject",
      "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "content_digest": { "type": "ref", "ref": "sha256_hex" }, "content_schema_version": { "type": "integer", "minimum": 1, "maximum": 2 } }
    },
    "tool_binding": {
      "type": "object", "required": ["publisher_id", "plugin_id", "workflow_id", "node_id", "tool_id", "manifest_version", "descriptor_sha256"], "max_keys": 7, "additional_properties": "reject",
      "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "workflow_id": { "type": "ref", "ref": "contribution_id" }, "node_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "max_utf8_bytes": 64 }, "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "max_utf8_bytes": 64 }, "manifest_version": { "type": "const", "value": 2 }, "descriptor_sha256": { "type": "ref", "ref": "sha256_hex" } }
    },
    "settings_item": {
      "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "state_digest", "revision"], "max_keys": 5, "additional_properties": "reject",
      "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "state_digest": { "type": "ref", "ref": "sha256_hex" }, "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } }
    }
  },
  "root": {
    "type": "object", "required": ["kind", "runtime_schema_version", "registry_revision", "dependency_graph_hash", "commit_epoch", "active_generation_id", "declarative_content", "workflow_tool_bindings", "settings_states"], "max_keys": 9, "additional_properties": "reject",
    "properties": {
      "kind": { "type": "const", "value": "plugin_runtime_snapshot" }, "runtime_schema_version": { "type": "const", "value": 2 }, "registry_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "dependency_graph_hash": { "type": "ref", "ref": "sha256_hex" }, "commit_epoch": { "type": "ref", "ref": "commit_epoch" }, "active_generation_id": { "type": "ref", "ref": "generation_id" },
      "declarative_content": {
        "type": "object", "required": ["skill_scopes", "prompts", "themes", "settings_schemas", "commands", "workflows", "mcp_descriptors"], "max_keys": 7, "additional_properties": "reject",
        "properties": {
          "skill_scopes": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
          "prompts": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
          "themes": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
          "settings_schemas": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
          "commands": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
          "workflows": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
          "mcp_descriptors": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } }
        }
      },
      "workflow_tool_bindings": { "type": "array", "max_items": 256, "unique_by": ["publisher_id", "plugin_id", "workflow_id", "node_id"], "items": { "type": "ref", "ref": "tool_binding" } },
      "settings_states": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "settings_item" } }
    }
  }
}
