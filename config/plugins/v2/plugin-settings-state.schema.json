{
  "contract": "PluginSettingsStateV2", "contract_version": 2, "frozen": true,
  "defs": {
    "setting_value": {
      "type": "tagged_union", "tag_field": "type",
      "variants": {
        "boolean": { "type": "object", "required": ["type", "key", "value"], "max_keys": 3, "additional_properties": "reject", "properties": { "type": { "type": "const", "value": "boolean" }, "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "max_utf8_bytes": 64 }, "value": { "type": "boolean" } } },
        "integer": { "type": "object", "required": ["type", "key", "value"], "max_keys": 3, "additional_properties": "reject", "properties": { "type": { "type": "const", "value": "integer" }, "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "max_utf8_bytes": 64 }, "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 } } },
        "string": { "type": "object", "required": ["type", "key", "value"], "max_keys": 3, "additional_properties": "reject", "properties": { "type": { "type": "const", "value": "string" }, "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "max_utf8_bytes": 64 }, "value": { "type": "string", "max_utf8_bytes": 1024 } } }
      }
    }
  },
  "root": {
    "type": "object", "required": ["settings_state_schema_version", "publisher_id", "plugin_id", "contribution_id", "schema_digest", "revision", "updated_at", "values"], "max_keys": 8, "additional_properties": "reject",
    "properties": {
      "settings_state_schema_version": { "type": "const", "value": 2 },
      "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" },
      "schema_digest": { "type": "ref", "ref": "sha256_hex" }, "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "updated_at": { "type": "ref", "ref": "iso8601_utc" },
      "values": { "type": "array", "max_items": 32, "unique_by": ["key"], "items": { "type": "ref", "ref": "setting_value" } }
    }
  }
}
