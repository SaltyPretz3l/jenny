{
  "contract": "PluginGenerationV2", "contract_version": 2, "frozen": true,
  "defs": {
    "settings_ref": {
      "type": "tagged_union", "tag_field": "kind",
      "variants": {
        "absent": { "type": "object", "required": ["kind"], "max_keys": 1, "additional_properties": "reject", "properties": { "kind": { "type": "const", "value": "absent" } } },
        "state": { "type": "object", "required": ["kind", "digest", "revision"], "max_keys": 3, "additional_properties": "reject", "properties": { "kind": { "type": "const", "value": "state" }, "digest": { "type": "ref", "ref": "sha256_hex" }, "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } }
      }
    },
    "contribution_state": {
      "type": "object", "required": ["contribution_id", "kind", "content_digest", "desired_enabled", "effective_enabled", "blocked_reason", "settings_ref"], "max_keys": 7, "additional_properties": "reject",
      "properties": {
        "contribution_id": { "type": "ref", "ref": "contribution_id" }, "kind": { "type": "enum", "values": ["skill", "prompt", "theme", "settings_schema", "command", "workflow", "mcp_descriptor"] }, "content_digest": { "type": "ref", "ref": "sha256_hex" }, "desired_enabled": { "type": "boolean" }, "effective_enabled": { "type": "boolean" }, "blocked_reason": { "type": "enum", "values": ["none", "master_disabled", "dependency_disabled", "stage_forbidden", "invalid"] }, "settings_ref": { "type": "ref", "ref": "settings_ref" }
      }
    },
    "plugin_ref": { "type": "object", "required": ["publisher_id", "plugin_id"], "max_keys": 2, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" } } },
    "plugin_state": {
      "type": "object", "required": ["publisher_id", "plugin_id", "display_name", "resolved_version", "publisher_key_id", "artifact_digest", "desired_state", "effective_state", "checksum", "depends_on", "contributions"], "max_keys": 11, "additional_properties": "reject",
      "properties": {
        "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "display_name": { "type": "ref", "ref": "display_string" }, "resolved_version": { "type": "string", "format": "semver" }, "publisher_key_id": { "type": "ref", "ref": "sha256_hex" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" },
        "desired_state": { "type": "enum", "values": ["absent", "staged", "installed_disabled", "preparing", "active", "disabling", "blocked", "quarantined", "uninstalling"] }, "effective_state": { "type": "enum", "values": ["absent", "staged", "installed_disabled", "preparing", "active", "disabling", "blocked", "quarantined", "uninstalling"] }, "checksum": { "type": "ref", "ref": "sha256_hex" },
        "depends_on": { "type": "array", "max_items": 4, "unique_by": ["publisher_id", "plugin_id"], "items": { "type": "ref", "ref": "plugin_ref" } },
        "contributions": { "type": "array", "max_items": 32, "unique_by": ["contribution_id"], "items": { "type": "ref", "ref": "contribution_state" } }
      }
    },
    "policy_ref": { "type": "object", "required": ["policy_snapshot_digest", "policy_revision", "grant_set_digest"], "max_keys": 3, "additional_properties": "reject", "properties": { "policy_snapshot_digest": { "type": "ref", "ref": "sha256_hex" }, "policy_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "grant_set_digest": { "type": "ref", "ref": "sha256_hex" } } },
    "data_ref": { "type": "object", "required": ["domain", "schema_version"], "max_keys": 2, "additional_properties": "reject", "properties": { "domain": { "type": "string", "format": "nfc_identifier" }, "schema_version": { "type": "integer", "minimum": 1, "maximum": 9999 } } }
  },
  "root": {
    "type": "object", "required": ["generation_id", "generation_schema_version", "created_at", "graph_hash", "plugins", "policy_grant_ref", "data_schema_refs"], "max_keys": 7, "additional_properties": "reject",
    "properties": {
      "generation_id": { "type": "ref", "ref": "generation_id" }, "generation_schema_version": { "type": "const", "value": 2 }, "created_at": { "type": "ref", "ref": "iso8601_utc" }, "graph_hash": { "type": "ref", "ref": "sha256_hex" },
      "plugins": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id"], "items": { "type": "ref", "ref": "plugin_state" } }, "policy_grant_ref": { "type": "ref", "ref": "policy_ref" }, "data_schema_refs": { "type": "array", "max_items": 64, "unique_by": ["domain"], "items": { "type": "ref", "ref": "data_ref" } }
    }
  }
}
