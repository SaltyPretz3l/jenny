{
  "contract": "PluginRuntimeSnapshotV3", "contract_version": 3, "frozen": true,
  "defs": {
    "item": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "artifact_digest", "content_digest", "content_schema_version"], "max_keys": 6, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "content_digest": { "type": "ref", "ref": "sha256_hex" }, "content_schema_version": { "type": "integer", "minimum": 1, "maximum": 3 } } },
    "remote_contribution": { "type": "object", "required": ["kind", "remote_name", "namespaced_name", "description", "schema_digest", "schema_json"], "max_keys": 6, "additional_properties": "reject", "properties": { "kind": { "type": "enum", "values": ["tool", "resource", "prompt"] }, "remote_name": { "type": "ref", "ref": "bounded_id" }, "namespaced_name": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,191}$", "max_utf8_bytes": 192 }, "description": { "type": "string", "max_utf8_bytes": 1024 }, "schema_digest": { "type": "ref", "ref": "sha256_hex" }, "schema_json": { "type": "string", "max_utf8_bytes": 65536 } } },
    "remote_binding": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "binding_digest", "descriptor_digest", "artifact_digest", "endpoint_origin_digest", "negotiated_protocol", "auth_profile_ref", "contributions"], "max_keys": 10, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "binding_digest": { "type": "ref", "ref": "sha256_hex" }, "descriptor_digest": { "type": "ref", "ref": "sha256_hex" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "endpoint_origin_digest": { "type": "ref", "ref": "sha256_hex" }, "negotiated_protocol": { "type": "enum", "values": ["2026-07-28", "2025-11-25"] }, "auth_profile_ref": { "type": "ref", "ref": "sha256_hex" }, "contributions": { "type": "array", "max_items": 64, "unique_by": ["namespaced_name"], "items": { "type": "ref", "ref": "remote_contribution" } } } }
  },
  "root": {
    "type": "object", "required": ["kind", "runtime_schema_version", "registry_revision", "dependency_graph_hash", "commit_epoch", "active_generation_id", "declarative_content", "remote_mcp_bindings"], "max_keys": 8, "additional_properties": "reject",
    "properties": {
      "kind": { "type": "const", "value": "plugin_runtime_snapshot" }, "runtime_schema_version": { "type": "const", "value": 3 }, "registry_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "dependency_graph_hash": { "type": "ref", "ref": "sha256_hex" }, "commit_epoch": { "type": "ref", "ref": "commit_epoch" }, "active_generation_id": { "type": "ref", "ref": "generation_id" },
      "declarative_content": { "type": "array", "max_items": 256, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
      "remote_mcp_bindings": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "remote_binding" } }
    }
  }
}
