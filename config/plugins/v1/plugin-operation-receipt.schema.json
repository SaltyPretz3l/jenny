{
  "contract": "PluginOperationReceiptV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "operation_id",
      "request_fingerprint",
      "generation_id",
      "lifecycle_epoch",
      "commit_epoch",
      "status",
      "created_at",
      "updated_at",
      "retain_until"
    ],
    "max_keys": 13,
    "additional_properties": "preserve",
    "properties": {
      "operation_id": { "type": "ref", "ref": "operation_id" },
      "request_fingerprint": { "type": "ref", "ref": "sha256_hex" },
      "generation_id": { "type": "ref", "ref": "generation_id" },
      "lifecycle_epoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "commit_epoch": { "type": "ref", "ref": "commit_epoch" },
      "status": {
        "type": "enum",
        "values": ["pending", "committed", "failed", "indeterminate", "expired"]
      },
      "terminal_result_digest": { "type": "ref", "ref": "sha256_hex" },
      "created_at": { "type": "ref", "ref": "iso8601_utc" },
      "updated_at": { "type": "ref", "ref": "iso8601_utc" },
      "retain_until": { "type": "ref", "ref": "iso8601_utc" }
    }
  }
}
