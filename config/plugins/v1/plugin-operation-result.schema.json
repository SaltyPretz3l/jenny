{
  "contract": "PluginOperationResultV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "result_schema_version",
      "operation_id",
      "request_fingerprint",
      "status",
      "retryable",
      "authority_state_before",
      "authority_state_after",
      "cleanup_status",
      "cleanup_target",
      "settled_at"
    ],
    "max_keys": 12,
    "additional_properties": "reject",
    "properties": {
      "result_schema_version": { "type": "const", "value": 1 },
      "operation_id": { "type": "ref", "ref": "operation_id" },
      "request_fingerprint": { "type": "ref", "ref": "sha256_hex" },
      "status": {
        "type": "enum",
        "values": ["committed", "failed", "indeterminate", "expired"]
      },
      "retryable": { "type": "boolean" },
      "authority_state_before": { "type": "ref", "ref": "authority_state" },
      "authority_state_after": { "type": "ref", "ref": "authority_state" },
      "cleanup_status": {
        "type": "enum",
        "values": [
          "not_required",
          "settling",
          "complete",
          "termination_failed",
          "pending_restart"
        ]
      },
      "cleanup_target": { "type": "ref", "ref": "cleanup_target" },
      "settled_at": { "type": "ref", "ref": "iso8601_utc" },
      "failure": { "type": "ref", "ref": "failure_detail" },
      "recovery_guidance": { "type": "ref", "ref": "redacted_text" }
    }
  },
  "defs": {
    "authority_state": {
      "type": "enum",
      "values": [
        "absent",
        "staged",
        "installed_disabled",
        "preparing",
        "active",
        "disabling",
        "blocked",
        "quarantined",
        "uninstalling"
      ]
    },
    "redacted_text": {
      "type": "string",
      "pattern": "^[\\x20-\\x7E]{0,200}$",
      "max_utf8_bytes": 200
    },
    "failure_detail": {
      "type": "object",
      "required": ["code"],
      "max_keys": 3,
      "additional_properties": "reject",
      "properties": {
        "code": { "type": "string", "format": "nfc_identifier" },
        "wire_code": {
          "type": "string",
          "pattern": "^CMP-PLUGIN-[0-9]{4}$",
          "max_utf8_bytes": 15
        },
        "reason": { "type": "ref", "ref": "redacted_text" }
      }
    },
    "cleanup_target": {
      "type": "tagged_union",
      "tag_field": "kind",
      "variants": {
        "installed_disabled": {
          "type": "object",
          "required": ["kind"],
          "max_keys": 1,
          "additional_properties": "reject",
          "properties": {
            "kind": { "type": "const", "value": "installed_disabled" }
          }
        },
        "absent": {
          "type": "object",
          "required": ["kind"],
          "max_keys": 1,
          "additional_properties": "reject",
          "properties": {
            "kind": { "type": "const", "value": "absent" }
          }
        },
        "generation": {
          "type": "object",
          "required": ["kind", "generation_id"],
          "max_keys": 2,
          "additional_properties": "reject",
          "properties": {
            "kind": { "type": "const", "value": "generation" },
            "generation_id": { "type": "ref", "ref": "generation_id" }
          }
        }
      }
    }
  }
}
