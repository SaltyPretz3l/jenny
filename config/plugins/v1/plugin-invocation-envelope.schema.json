{
  "contract": "PluginInvocationEnvelopeV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "envelope_schema_version",
      "invocation_id",
      "operation_id",
      "publisher_id",
      "plugin_id",
      "contribution_id",
      "artifact_digest",
      "commit_epoch",
      "lifecycle_epoch",
      "policy_revision",
      "workspace_incarnation_id",
      "channel_id",
      "argument_hash",
      "deadline_epoch_ms",
      "cancellation_id",
      "budgets"
    ],
    "max_keys": 16,
    "additional_properties": "reject",
    "properties": {
      "envelope_schema_version": { "type": "const", "value": 1 },
      "invocation_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "max_utf8_bytes": 64
      },
      "operation_id": { "type": "ref", "ref": "operation_id" },
      "publisher_id": { "type": "ref", "ref": "publisher_id" },
      "plugin_id": { "type": "ref", "ref": "plugin_id" },
      "contribution_id": { "type": "ref", "ref": "contribution_id" },
      "artifact_digest": { "type": "ref", "ref": "sha256_hex" },
      "commit_epoch": { "type": "ref", "ref": "commit_epoch" },
      "lifecycle_epoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "policy_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "workspace_incarnation_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "max_utf8_bytes": 64
      },
      "channel_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "max_utf8_bytes": 64
      },
      "argument_hash": { "type": "ref", "ref": "sha256_hex" },
      "deadline_epoch_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "cancellation_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "max_utf8_bytes": 64
      },
      "budgets": {
        "type": "object",
        "required": [
          "max_stream_frames",
          "max_frame_utf8_bytes",
          "max_stream_total_utf8_bytes",
          "max_result_utf8_bytes"
        ],
        "max_keys": 4,
        "additional_properties": "reject",
        "properties": {
          "max_stream_frames": { "type": "integer", "minimum": 1, "maximum": 256 },
          "max_frame_utf8_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "max_stream_total_utf8_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
          "max_result_utf8_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
        }
      }
    }
  }
}
