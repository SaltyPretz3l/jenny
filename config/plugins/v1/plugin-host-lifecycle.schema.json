{
  "contract": "PluginHostLifecycleV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "lifecycle_schema_version",
      "host_id",
      "contribution_id",
      "commit_epoch",
      "lifecycle_epoch",
      "state",
      "load_deadline_epoch_ms"
    ],
    "max_keys": 10,
    "additional_properties": "reject",
    "properties": {
      "lifecycle_schema_version": { "type": "const", "value": 1 },
      "host_id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "max_utf8_bytes": 64
      },
      "contribution_id": { "type": "ref", "ref": "contribution_id" },
      "commit_epoch": { "type": "ref", "ref": "commit_epoch" },
      "lifecycle_epoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "state": {
        "type": "enum",
        "values": ["cold", "provisioning", "loading", "ready", "idle", "evicting"]
      },
      "load_deadline_epoch_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "idle_since_epoch_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "idle_eviction_deadline_epoch_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "load_progress": {
        "type": "object",
        "required": ["sequence", "percent"],
        "max_keys": 3,
        "additional_properties": "reject",
        "properties": {
          "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "detail": {
            "type": "string",
            "pattern": "^[\\x20-\\x7E]{0,200}$",
            "max_utf8_bytes": 200
          }
        }
      }
    }
  }
}
