{
  "contract": "PluginPackageRecordV1",
  "contract_version": 1,
  "frozen": true,
  "defs": {
    "source_identity": {
      "type": "object",
      "required": ["kind", "package_path_digest"],
      "max_keys": 2,
      "additional_properties": "reject",
      "properties": {
        "kind": { "type": "const", "value": "local_package" },
        "package_path_digest": { "type": "ref", "ref": "sha256_hex" }
      }
    }
  },
  "root": {
    "type": "object",
    "required": [
      "package_record_schema_version",
      "publisher_id",
      "plugin_id",
      "content_digest",
      "version_axes",
      "canonical_metadata_digest",
      "signature_bundle_state",
      "source_identity",
      "size_evidence",
      "risk_flags",
      "created_at"
    ],
    "max_keys": 11,
    "additional_properties": "reject",
    "properties": {
      "package_record_schema_version": { "type": "const", "value": 1 },
      "publisher_id": { "type": "ref", "ref": "publisher_id" },
      "plugin_id": { "type": "ref", "ref": "plugin_id" },
      "content_digest": { "type": "ref", "ref": "sha256_hex" },
      "version_axes": {
        "type": "object",
        "required": [
          "package_semver",
          "manifest_schema_version",
          "contribution_contract_version",
          "capability_abi_version",
          "data_schema_version"
        ],
        "max_keys": 5,
        "additional_properties": "reject",
        "properties": {
          "package_semver": { "type": "string", "format": "semver" },
          "manifest_schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "contribution_contract_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "capability_abi_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "data_schema_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          }
        }
      },
      "canonical_metadata_digest": { "type": "ref", "ref": "sha256_hex" },
      "signature_bundle_state": {
        "type": "object",
        "required": ["state", "publisher_id", "signing_key_id", "signature_algorithm"],
        "max_keys": 4,
        "additional_properties": "reject",
        "properties": {
          "state": { "type": "const", "value": "verified" },
          "publisher_id": { "type": "ref", "ref": "publisher_id" },
          "signing_key_id": { "type": "ref", "ref": "sha256_hex" },
          "signature_algorithm": {
            "type": "enum",
            "values": ["ed25519"]
          }
        }
      },
      "source_identity": { "type": "ref", "ref": "source_identity" },
      "size_evidence": {
        "type": "object",
        "required": ["archive_bytes", "entry_count", "uncompressed_bytes"],
        "max_keys": 3,
        "additional_properties": "reject",
        "properties": {
          "archive_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "entry_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4096
          },
          "uncompressed_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          }
        }
      },
      "risk_flags": {
        "type": "array",
        "max_items": 6,
        "items": {
          "type": "enum",
          "values": [
            "known_vulnerability",
            "permission_changed",
            "incompatible",
            "dependency_broken",
            "policy_blocked",
            "crash_loop"
          ]
        }
      },
      "created_at": { "type": "ref", "ref": "iso8601_utc" }
    }
  }
}
