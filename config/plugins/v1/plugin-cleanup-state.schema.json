{
  "contract": "PluginCleanupStateV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "cleanup_status",
      "cleanup_target",
      "lifecycle_epoch",
      "commit_epoch",
      "cleanup_detail"
    ],
    "max_keys": 5,
    "additional_properties": "reject",
    "properties": {
      "cleanup_status": {
        "type": "enum",
        "values": [
          "not_required",
          "settling",
          "complete",
          "termination_failed",
          "pending_restart"
        ]
      },
      "cleanup_target": {
        "type": "tagged_union",
        "tag_field": "kind",
        "variants": {
          "installed_disabled": {
            "type": "object",
            "required": ["kind"],
            "max_keys": 1,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "installed_disabled" }
            }
          },
          "absent": {
            "type": "object",
            "required": ["kind"],
            "max_keys": 1,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "absent" }
            }
          },
          "generation": {
            "type": "object",
            "required": ["kind", "generation_id"],
            "max_keys": 2,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "generation" },
              "generation_id": { "type": "ref", "ref": "generation_id" }
            }
          }
        }
      },
      "lifecycle_epoch": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "commit_epoch": { "type": "ref", "ref": "commit_epoch" },
      "cleanup_detail": {
        "type": "object",
        "required": ["code", "retryable"],
        "max_keys": 3,
        "additional_properties": "reject",
        "properties": {
          "code": { "type": "string", "format": "nfc_identifier" },
          "retryable": { "type": "boolean" },
          "reason": {
            "type": "string",
            "pattern": "^[\\x20-\\x7E]{0,200}$",
            "max_utf8_bytes": 200
          }
        }
      }
    }
  }
}
