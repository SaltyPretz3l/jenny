{
  "contract": "PluginSourceTrustV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "source_trust_schema_version",
      "publisher_id",
      "publisher_trust_root",
      "key_rotation_evidence",
      "source"
    ],
    "max_keys": 5,
    "additional_properties": "reject",
    "properties": {
      "source_trust_schema_version": { "type": "const", "value": 1 },
      "publisher_id": { "type": "ref", "ref": "publisher_id" },
      "publisher_trust_root": {
        "type": "object",
        "required": ["status", "current_key_id"],
        "max_keys": 4,
        "additional_properties": "reject",
        "properties": {
          "status": {
            "type": "enum",
            "values": ["unestablished", "established", "revoked"]
          },
          "current_key_id": { "type": "ref", "ref": "sha256_hex" },
          "established_at": { "type": "ref", "ref": "iso8601_utc" },
          "revoked_at": { "type": "ref", "ref": "iso8601_utc" }
        }
      },
      "key_rotation_evidence": {
        "type": "array",
        "max_items": 32,
        "unique_by": ["to_key_id"],
        "items": {
          "type": "object",
          "required": ["from_key_id", "to_key_id", "delegation_signature_digest", "rotated_at"],
          "max_keys": 4,
          "additional_properties": "reject",
          "properties": {
            "from_key_id": { "type": "ref", "ref": "sha256_hex" },
            "to_key_id": { "type": "ref", "ref": "sha256_hex" },
            "delegation_signature_digest": { "type": "ref", "ref": "sha256_hex" },
            "rotated_at": { "type": "ref", "ref": "iso8601_utc" }
          }
        }
      },
      "source": {
        "type": "tagged_union",
        "tag_field": "kind",
        "variants": {
          "local_package": {
            "type": "object",
            "required": ["kind", "package_path_digest", "sbom_exempt"],
            "max_keys": 3,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "local_package" },
              "package_path_digest": { "type": "ref", "ref": "sha256_hex" },
              "sbom_exempt": { "type": "boolean" }
            }
          },
          "developer_link": {
            "type": "object",
            "required": ["kind", "link_digest", "live_reload_isolated_profile"],
            "max_keys": 3,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "developer_link" },
              "link_digest": { "type": "ref", "ref": "sha256_hex" },
              "live_reload_isolated_profile": { "type": "boolean" }
            }
          },
          "git": {
            "type": "object",
            "required": ["kind", "repository_url_digest", "pinned_commit"],
            "max_keys": 3,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "git" },
              "repository_url_digest": { "type": "ref", "ref": "sha256_hex" },
              "pinned_commit": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
                "max_utf8_bytes": 64
              }
            }
          },
          "https_url": {
            "type": "object",
            "required": ["kind", "url_digest"],
            "max_keys": 2,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "https_url" },
              "url_digest": { "type": "ref", "ref": "sha256_hex" }
            }
          },
          "signed_catalog": {
            "type": "object",
            "required": ["kind", "catalog_id", "tuf_root_digest", "sbom_attested"],
            "max_keys": 4,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "signed_catalog" },
              "catalog_id": { "type": "string", "format": "nfc_identifier" },
              "tuf_root_digest": { "type": "ref", "ref": "sha256_hex" },
              "sbom_attested": { "type": "boolean" }
            }
          },
          "offline_mirror": {
            "type": "object",
            "required": ["kind", "mirror_id", "tuf_root_digest", "sbom_attested"],
            "max_keys": 4,
            "additional_properties": "reject",
            "properties": {
              "kind": { "type": "const", "value": "offline_mirror" },
              "mirror_id": { "type": "string", "format": "nfc_identifier" },
              "tuf_root_digest": { "type": "ref", "ref": "sha256_hex" },
              "sbom_attested": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
