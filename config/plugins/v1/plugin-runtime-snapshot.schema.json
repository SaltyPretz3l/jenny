{
  "contract": "PluginRuntimeSnapshotV1",
  "contract_version": 1,
  "frozen": true,
  "defs": {
    "declarative_item": {
      "type": "object",
      "required": ["publisher_id", "plugin_id", "contribution_id", "artifact_digest", "content_digest"],
      "max_keys": 5,
      "additional_properties": "reject",
      "properties": {
        "publisher_id": { "type": "ref", "ref": "publisher_id" },
        "plugin_id": { "type": "ref", "ref": "plugin_id" },
        "contribution_id": { "type": "ref", "ref": "contribution_id" },
        "artifact_digest": { "type": "ref", "ref": "sha256_hex" },
        "content_digest": { "type": "ref", "ref": "sha256_hex" }
      }
    }
  },
  "root": {
    "type": "object",
    "required": [
      "kind",
      "registry_revision",
      "dependency_graph_hash",
      "commit_epoch",
      "active_generation_id",
      "declarative_content"
    ],
    "max_keys": 6,
    "additional_properties": "reject",
    "properties": {
      "kind": { "type": "const", "value": "plugin_runtime_snapshot" },
      "registry_revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "dependency_graph_hash": { "type": "ref", "ref": "sha256_hex" },
      "commit_epoch": { "type": "ref", "ref": "commit_epoch" },
      "active_generation_id": { "type": "ref", "ref": "generation_id" },
      "declarative_content": {
        "type": "object",
        "required": ["skill_scopes", "prompts", "themes", "settings_schemas", "commands", "workflows", "mcp_descriptors"],
        "max_keys": 7,
        "additional_properties": "reject",
        "properties": {
          "skill_scopes": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          },
          "prompts": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          },
          "themes": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          },
          "settings_schemas": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          },
          "commands": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          },
          "workflows": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          },
          "mcp_descriptors": {
            "type": "array",
            "max_items": 64,
            "unique_by": ["publisher_id", "plugin_id", "contribution_id"],
            "items": { "type": "ref", "ref": "declarative_item" }
          }
        }
      }
    }
  }
}
