{
  "contract": "PluginPublisherTrustRootsV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": ["trust_roots_schema_version", "updated_at", "publishers"],
    "max_keys": 3,
    "additional_properties": "reject",
    "properties": {
      "trust_roots_schema_version": { "type": "const", "value": 1 },
      "updated_at": { "type": "ref", "ref": "iso8601_utc" },
      "publishers": {
        "type": "array",
        "max_items": 32,
        "unique_by": ["publisher_id"],
        "items": {
          "type": "object",
          "required": ["publisher_id", "current_key_id", "established_at", "keys"],
          "max_keys": 4,
          "additional_properties": "reject",
          "properties": {
            "publisher_id": { "type": "ref", "ref": "publisher_id" },
            "current_key_id": { "type": "ref", "ref": "sha256_hex" },
            "established_at": { "type": "ref", "ref": "iso8601_utc" },
            "keys": {
              "type": "array",
              "max_items": 8,
              "unique_by": ["key_id"],
              "items": {
                "type": "object",
                "required": ["key_id", "fingerprint", "algorithm", "public_key_spki_der_base64", "status", "added_at"],
                "max_keys": 7,
                "additional_properties": "reject",
                "properties": {
                  "key_id": { "type": "ref", "ref": "sha256_hex" },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^SHA256:[A-Za-z0-9+/]{43}=$",
                    "max_utf8_bytes": 51
                  },
                  "algorithm": { "type": "const", "value": "ed25519" },
                  "public_key_spki_der_base64": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]{56,120}={0,2}$",
                    "max_utf8_bytes": 122
                  },
                  "status": { "type": "enum", "values": ["active", "rotated", "revoked"] },
                  "added_at": { "type": "ref", "ref": "iso8601_utc" },
                  "revoked_at": { "type": "ref", "ref": "iso8601_utc" }
                }
              }
            }
          }
        }
      }
    }
  }
}
