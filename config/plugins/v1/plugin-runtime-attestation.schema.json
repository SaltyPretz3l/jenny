{
  "contract": "PluginRuntimeAttestationV1",
  "contract_version": 1,
  "frozen": true,
  "root": {
    "type": "object",
    "required": [
      "attestation_schema_version",
      "participant_kind",
      "registry_revision",
      "dependency_graph_hash",
      "commit_epoch",
      "sidecar_plugin_generation",
      "reused_resource_proofs",
      "rejected_contributions"
    ],
    "max_keys": 8,
    "additional_properties": "reject",
    "properties": {
      "attestation_schema_version": { "type": "const", "value": 1 },
      "participant_kind": {
        "type": "enum",
        "values": ["sidecar", "restricted_host", "full_host", "view_host"]
      },
      "registry_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
      "dependency_graph_hash": { "type": "ref", "ref": "sha256_hex" },
      "commit_epoch": { "type": "ref", "ref": "commit_epoch" },
      "sidecar_plugin_generation": { "type": "ref", "ref": "generation_id" },
      "reused_resource_proofs": {
        "type": "array",
        "max_items": 16,
        "unique_by": ["resource_id"],
        "items": {
          "type": "object",
          "required": ["resource_kind", "resource_id", "digest"],
          "max_keys": 3,
          "additional_properties": "reject",
          "properties": {
            "resource_kind": {
              "type": "enum",
              "values": ["engine", "model", "memory", "mcp", "monitor", "tool"]
            },
            "resource_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$",
              "max_utf8_bytes": 128
            },
            "digest": { "type": "ref", "ref": "sha256_hex" }
          }
        }
      },
      "rejected_contributions": {
        "type": "array",
        "max_items": 32,
        "unique_by": ["contribution_id"],
        "items": {
          "type": "object",
          "required": ["contribution_id", "reason_code", "retryable"],
          "max_keys": 3,
          "additional_properties": "reject",
          "properties": {
            "contribution_id": { "type": "ref", "ref": "contribution_id" },
            "reason_code": { "type": "string", "format": "nfc_identifier" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
