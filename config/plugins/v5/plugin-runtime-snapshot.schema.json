{
  "contract": "PluginRuntimeSnapshotV5", "contract_version": 5, "frozen": true,
  "defs": {
    "item": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "artifact_digest", "content_digest", "content_schema_version"], "max_keys": 6, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "content_digest": { "type": "ref", "ref": "sha256_hex" }, "content_schema_version": { "type": "integer", "minimum": 1, "maximum": 5 } } },
    "view": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "kind", "artifact_digest", "content_digest", "entry_path", "entry_digest"], "max_keys": 8, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "kind": { "type": "enum", "values": ["setup_scene", "panel", "artifact_renderer"] }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "content_digest": { "type": "ref", "ref": "sha256_hex" }, "entry_path": { "type": "ref", "ref": "asset_path" }, "entry_digest": { "type": "ref", "ref": "sha256_hex" } } },
    "provider": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "provider_id", "engine_type", "artifact_digest", "descriptor_digest"], "max_keys": 7, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "provider_id": { "type": "ref", "ref": "bounded_id" }, "engine_type": { "type": "const", "value": "chatgpt" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "descriptor_digest": { "type": "ref", "ref": "sha256_hex" } } },
    "restricted": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "kind", "artifact_digest", "content_digest", "component_digest", "abi_digest", "timeout_ms"], "max_keys": 9, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "kind": { "type": "enum", "values": ["restricted_transform", "restricted_formatter", "restricted_renderer", "restricted_compute"] }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "content_digest": { "type": "ref", "ref": "sha256_hex" }, "component_digest": { "type": "ref", "ref": "sha256_hex" }, "abi_digest": { "type": "ref", "ref": "sha256_hex" }, "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 120000 } } },
    "remote_contribution": { "type": "object", "required": ["kind", "remote_name", "namespaced_name", "description", "schema_digest", "schema_json"], "max_keys": 6, "additional_properties": "reject", "properties": { "kind": { "type": "enum", "values": ["tool", "resource", "prompt"] }, "remote_name": { "type": "ref", "ref": "bounded_id" }, "namespaced_name": { "type": "ref", "ref": "bounded_name" }, "description": { "type": "string", "max_utf8_bytes": 1024 }, "schema_digest": { "type": "ref", "ref": "sha256_hex" }, "schema_json": { "type": "string", "max_utf8_bytes": 65536 } } },
    "remote_binding": { "type": "object", "required": ["publisher_id", "plugin_id", "contribution_id", "binding_digest", "descriptor_digest", "artifact_digest", "endpoint_origin_digest", "negotiated_protocol", "auth_profile_ref", "contributions"], "max_keys": 10, "additional_properties": "reject", "properties": { "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "contribution_id": { "type": "ref", "ref": "contribution_id" }, "binding_digest": { "type": "ref", "ref": "sha256_hex" }, "descriptor_digest": { "type": "ref", "ref": "sha256_hex" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "endpoint_origin_digest": { "type": "ref", "ref": "sha256_hex" }, "negotiated_protocol": { "type": "enum", "values": ["2026-07-28", "2025-11-25"] }, "auth_profile_ref": { "type": "ref", "ref": "sha256_hex" }, "contributions": { "type": "array", "max_items": 64, "unique_by": ["namespaced_name"], "items": { "type": "ref", "ref": "remote_contribution" } } } }
  },
  "root": { "type": "object", "required": ["kind", "runtime_schema_version", "registry_revision", "dependency_graph_hash", "commit_epoch", "active_generation_id", "declarative_content", "remote_mcp_bindings", "restricted_contributions", "view_contributions", "provider_descriptors"], "max_keys": 11, "additional_properties": "reject", "properties": {
    "kind": { "type": "const", "value": "plugin_runtime_snapshot" }, "runtime_schema_version": { "type": "const", "value": 5 }, "registry_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "dependency_graph_hash": { "type": "ref", "ref": "sha256_hex" }, "commit_epoch": { "type": "ref", "ref": "commit_epoch" }, "active_generation_id": { "type": "ref", "ref": "generation_id" },
    "declarative_content": { "type": "array", "max_items": 256, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "item" } },
    "remote_mcp_bindings": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "remote_binding" } },
    "restricted_contributions": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "restricted" } },
    "view_contributions": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "view" } },
    "provider_descriptors": { "type": "array", "max_items": 8, "unique_by": ["publisher_id", "plugin_id", "contribution_id"], "items": { "type": "ref", "ref": "provider" } }
  } }
}
