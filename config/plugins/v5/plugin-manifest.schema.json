{
  "contract": "PluginManifestV5", "contract_version": 5, "frozen": true,
  "defs": {
    "contribution": {
      "type": "object", "required": ["kind", "contribution_id", "name", "content_path", "content_sha256"], "max_keys": 8, "additional_properties": "reject",
      "properties": {
        "kind": { "type": "enum", "values": ["skill", "prompt", "theme", "settings_schema", "command", "workflow", "mcp_descriptor", "restricted_transform", "restricted_formatter", "restricted_renderer", "restricted_compute", "setup_scene", "panel", "artifact_renderer", "provider_descriptor"] },
        "contribution_id": { "type": "ref", "ref": "contribution_id" },
        "name": { "type": "ref", "ref": "display_string" },
        "content_path": { "type": "ref", "ref": "asset_path" },
        "content_sha256": { "type": "ref", "ref": "sha256_hex" },
        "component_path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}\\.wasm$", "max_utf8_bytes": 240 },
        "component_sha256": { "type": "ref", "ref": "sha256_hex" },
        "abi_world": { "type": "const", "value": "jenny:plugin/restricted-host@1.0.0" }
      }
    },
    "dependency": {
      "type": "object", "required": ["kind", "publisher_id", "plugin_id", "version_range"], "max_keys": 4, "additional_properties": "reject",
      "properties": { "kind": { "type": "enum", "values": ["required", "peer", "optional"] }, "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "version_range": { "type": "ref", "ref": "semver_range" } }
    }
  },
  "root": {
    "type": "object", "required": ["manifest_schema_version", "publisher_id", "plugin_id", "name", "version", "contract_versions", "contributions", "dependencies", "requested_permissions"], "max_keys": 9, "additional_properties": "reject",
    "properties": {
      "manifest_schema_version": { "type": "const", "value": 5 }, "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "name": { "type": "ref", "ref": "display_string" }, "version": { "type": "string", "format": "semver" },
      "contract_versions": { "type": "object", "required": ["manifest", "view_content", "provider_descriptor", "generation", "runtime_snapshot", "view_call", "view_result", "view_event"], "max_keys": 8, "additional_properties": "reject", "properties": { "manifest": { "type": "const", "value": 5 }, "view_content": { "type": "const", "value": 5 }, "provider_descriptor": { "type": "const", "value": 5 }, "generation": { "type": "const", "value": 5 }, "runtime_snapshot": { "type": "const", "value": 5 }, "view_call": { "type": "const", "value": 5 }, "view_result": { "type": "const", "value": 5 }, "view_event": { "type": "const", "value": 5 } } },
      "contributions": { "type": "array", "max_items": 32, "unique_by": ["contribution_id"], "items": { "type": "ref", "ref": "contribution" } },
      "dependencies": { "type": "array", "max_items": 16, "unique_by": ["publisher_id", "plugin_id"], "items": { "type": "ref", "ref": "dependency" } },
      "requested_permissions": { "type": "array", "max_items": 5, "unique_by": [], "items": { "type": "enum", "values": ["network.remote_mcp", "network.restricted_runtime", "network.fetch", "ui.view", "secret.brokered_use"] } }
    }
  }
}
