{
  "contract": "PluginViewContentV5", "contract_version": 5, "frozen": true,
  "defs": {
    "asset": { "type": "object", "required": ["path", "sha256", "media_type", "bytes"], "max_keys": 4, "additional_properties": "reject", "properties": { "path": { "type": "ref", "ref": "asset_path" }, "sha256": { "type": "ref", "ref": "sha256_hex" }, "media_type": { "type": "enum", "values": ["text/html", "text/css", "text/javascript", "application/javascript", "application/json", "image/png", "image/jpeg", "image/webp", "image/svg+xml", "font/woff2"] }, "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 } } }
  },
  "root": {
    "type": "object", "required": ["content_schema_version", "view_kind", "entry_path", "entry_sha256", "assets", "allowed_bridge_operations", "allowed_event_topics", "artifact_kinds", "provider_ref"], "max_keys": 9, "additional_properties": "reject",
    "properties": {
      "content_schema_version": { "type": "const", "value": 5 }, "view_kind": { "type": "enum", "values": ["setup_scene", "panel", "artifact_renderer"] }, "entry_path": { "type": "ref", "ref": "asset_path" }, "entry_sha256": { "type": "ref", "ref": "sha256_hex" },
      "assets": { "type": "array", "max_items": 256, "unique_by": ["path"], "items": { "type": "ref", "ref": "asset" } },
      "allowed_bridge_operations": { "type": "array", "max_items": 10, "unique_by": [], "items": { "type": "enum", "values": ["get_context", "read_settings", "update_settings", "provider_auth_status", "provider_auth_start", "provider_auth_cancel", "provider_auth_sign_out", "provider_activate", "artifact_read_chunk", "artifact_ready", "artifact_error"] } },
      "allowed_event_topics": { "type": "array", "max_items": 4, "unique_by": [], "items": { "type": "enum", "values": ["context_changed", "settings_changed", "provider_auth_changed", "artifact_changed"] } },
      "artifact_kinds": { "type": "array", "max_items": 16, "unique_by": [], "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}:[a-z][a-z0-9_.-]{0,63}$", "max_utf8_bytes": 129 } },
      "provider_ref": { "type": "string", "pattern": "^(|[a-z][a-z0-9_.-]{0,63})$", "max_utf8_bytes": 64 }
    }
  }
}
