{
  "contract": "PluginGenerationV5", "contract_version": 5, "frozen": true,
  "defs": {
    "plugin_state": {
      "type": "object", "required": ["publisher_id", "plugin_id", "display_name", "resolved_version", "publisher_key_id", "artifact_digest", "package_record_digest", "source_trust_digest", "advisory_snapshot_digest", "data_snapshot_digest", "desired_state", "effective_state", "checksum", "remote_binding_digests", "restricted_module_digests", "view_content_digests", "provider_descriptor_digests"], "max_keys": 17, "additional_properties": "reject",
      "properties": {
        "publisher_id": { "type": "ref", "ref": "publisher_id" }, "plugin_id": { "type": "ref", "ref": "plugin_id" }, "display_name": { "type": "ref", "ref": "display_string" }, "resolved_version": { "type": "string", "format": "semver" }, "publisher_key_id": { "type": "ref", "ref": "sha256_hex" }, "artifact_digest": { "type": "ref", "ref": "sha256_hex" }, "package_record_digest": { "type": "ref", "ref": "sha256_hex" }, "source_trust_digest": { "type": "ref", "ref": "sha256_hex" }, "advisory_snapshot_digest": { "type": "ref", "ref": "sha256_hex" }, "data_snapshot_digest": { "type": "ref", "ref": "sha256_hex" },
        "desired_state": { "type": "enum", "values": ["absent", "staged", "installed_disabled", "preparing", "active", "disabling", "blocked", "quarantined", "uninstalling"] }, "effective_state": { "type": "enum", "values": ["absent", "staged", "installed_disabled", "preparing", "active", "disabling", "blocked", "quarantined", "uninstalling"] }, "checksum": { "type": "ref", "ref": "sha256_hex" },
        "remote_binding_digests": { "type": "array", "max_items": 32, "unique_by": [], "items": { "type": "ref", "ref": "sha256_hex" } }, "restricted_module_digests": { "type": "array", "max_items": 32, "unique_by": [], "items": { "type": "ref", "ref": "sha256_hex" } }, "view_content_digests": { "type": "array", "max_items": 32, "unique_by": [], "items": { "type": "ref", "ref": "sha256_hex" } }, "provider_descriptor_digests": { "type": "array", "max_items": 8, "unique_by": [], "items": { "type": "ref", "ref": "sha256_hex" } }
      }
    },
    "policy_ref": { "type": "object", "required": ["policy_snapshot_digest", "policy_revision", "grant_set_digest", "network_consent_digest", "restricted_runtime_policy_digest", "view_policy_digest", "provider_policy_digest"], "max_keys": 7, "additional_properties": "reject", "properties": { "policy_snapshot_digest": { "type": "ref", "ref": "sha256_hex" }, "policy_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, "grant_set_digest": { "type": "ref", "ref": "sha256_hex" }, "network_consent_digest": { "type": "ref", "ref": "sha256_hex" }, "restricted_runtime_policy_digest": { "type": "ref", "ref": "sha256_hex" }, "view_policy_digest": { "type": "ref", "ref": "sha256_hex" }, "provider_policy_digest": { "type": "ref", "ref": "sha256_hex" } } }
  },
  "root": { "type": "object", "required": ["generation_id", "generation_schema_version", "created_at", "graph_hash", "lock_digest", "distribution_state_digest", "plugins", "policy_grant_ref"], "max_keys": 8, "additional_properties": "reject", "properties": { "generation_id": { "type": "ref", "ref": "generation_id" }, "generation_schema_version": { "type": "const", "value": 5 }, "created_at": { "type": "ref", "ref": "iso8601_utc" }, "graph_hash": { "type": "ref", "ref": "sha256_hex" }, "lock_digest": { "type": "ref", "ref": "sha256_hex" }, "distribution_state_digest": { "type": "ref", "ref": "sha256_hex" }, "plugins": { "type": "array", "max_items": 64, "unique_by": ["publisher_id", "plugin_id"], "items": { "type": "ref", "ref": "plugin_state" } }, "policy_grant_ref": { "type": "ref", "ref": "policy_ref" } } }
}
