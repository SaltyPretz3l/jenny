# Every text file checks out LF on every platform, overriding a machine-wide
# core.autocrlf=true. Mixed CRLF/LF working trees made tools write the wrong
# ending into .py/.md files. Windows batch scripts are the only CRLF exception.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
# Runtime source, renderer byte-budget inputs, and package/signing inputs are
# consumed as exact bytes. Keep them stable across Windows and POSIX checkouts.
*.js text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
# The generated ledger is compared byte-for-byte with its LF generator output.
docs/i18n/STRING_LEDGER.md text eol=lf
renderer/inventory/assets/*.svg text eol=lf
# Shell entrypoints must stay LF on every platform (CRLF breaks bash: "/bin/bash^M").
*.sh text eol=lf
setup.command text eol=lf
# Release-compat payloads are hash-pinned binary fixtures; never rewrite bytes.
tests/release-compat/fixtures/jenny-archive-v1-plain/data/preferences/fixture.txt -text
archive/** linguist-generated
repomix/** linguist-generated
vendor/** linguist-vendored

# Workspace document-editing fixtures: byte-exact PDF/DOCX inputs (annotated.pdf has no NUL bytes and would otherwise be eol-normalized).
tests/fixtures/documents/*.pdf binary
tests/fixtures/documents/*.docx binary

# Session journal fixtures are CRC-framed: their bytes must never be normalized.
tests/release-compat/fixtures/**/*.journal -text
