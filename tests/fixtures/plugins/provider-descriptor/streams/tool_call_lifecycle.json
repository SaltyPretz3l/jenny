        "captures": []
      },
      "expect": {
        "max_reasoning_items": 32
      },
      "rule": "Direct construction with no admitted budget keeps today's floor of 32 entries; the bound is never below it."
    },
    {
      "case_id": "cache_bound_tracks_the_admitted_tool_budget",
      "executable": true,
      "binding": "reasoning_cache",
      "input": {
        "requested_max_reasoning_items": 200,
        "captures": []
      },
      "expect": {
        "max_reasoning_items": 200
      },
      "rule": "The factory sizes the cache from max(cloud_max_tools_per_turn, max_tools_per_turn) so one turn's whole tool budget fits: a smaller cache would silently drop the oldest calls' reasoning items partway through a long turn."
    },
    {
      "case_id": "cache_bound_is_clamped_at_the_ceiling",
