      },
      "rule": "With store:false the backend expects each replayed function_call to be preceded by the reasoning item that produced it. The cached item is spliced in at exactly the position before its call on a LATER HTTP request -- state no per-event mapping can express."
    },
    {
      "case_id": "cache_bound_floors_at_thirty_two",
      "executable": true,
      "binding": "reasoning_cache",
      "input": {
