      "expect": {
        "turn_2_request_input_items": [
          {
            "type": "message",
            "role": "user",
            "content": [
              {
                "type": "input_text",
                "text": "go"
              }
            ]
          },
          {
            "type": "reasoning",
            "id": "rs_test_1",
            "encrypted_content": "synthetic-opaque-reasoning-blob"
