    {
      "case_id": "aggregate_byte_ceiling_evicts_before_the_count_bound",
      "executable": true,
      "binding": "reasoning_cache",
      "input": {
        "requested_max_reasoning_items": 512,
        "captures": [
          {
            "call_id": "b0",
            "blob_chars": 3000000
          },
          {
            "call_id": "b1",
            "blob_chars": 3000000
          },
          {
            "call_id": "b2",
            "blob_chars": 3000000
          },
          {
            "call_id": "b3",
            "blob_chars": 3000000
          }
        ]
      },
      "expect": {
        "cache_size": 2,
        "cached_call_ids": [
          "b2",
          "b3"
        ],
        "max_reasoning_items": 512
      },
      "rule": "A count bound alone is not enough at 200-500 entries: reasoning items are opaque encrypted_content blobs of unbounded size, so an 8 MiB AGGREGATE byte ceiling evicts too. Four ~3 MB blobs leave only the newest two even though the count bound is 512."
    }
