{
  "description": "Scenario matrix driving services/plugins/data/migration-interpreter.js. Each scenario feeds evaluateMigration() and asserts the exact returned shape -- see tests/plugins/data/migration-interpreter.test.js.",
  "scenarios": [
    {
      "id": "successful_declarative_migration",
      "description": "A well-formed declarative migration renames a field, sets a default, drops a legacy field, and remaps an enum value. Every step succeeds; the migration commits.",
      "migration": {
        "executorTier": "declarative",
        "steps": [
          { "kind": "rename_field", "path": [], "from": "notes_text", "to": "body" },
          { "kind": "set_default", "path": [], "field": "pinned", "value": false },
          { "kind": "drop_field", "path": [], "field": "legacy_flag" },
          { "kind": "map_enum_value", "path": [], "field": "status", "mapping": { "todo": "open", "done": "closed" } }
        ]
      },
      "input": { "notes_text": "buy milk", "legacy_flag": true, "status": "todo" },
      "expected": {
        "ok": true,
        "value": { "body": "buy milk", "pinned": false, "status": "open" }
      }
    },
    {
      "id": "failed_migration_restores_prior_snapshot",
      "description": "The migration renames a field that does not exist in the input. The step fails, the whole migration fails closed, and the result tells the caller to restore the prior snapshot rather than commit a partial transform.",
      "migration": {
        "executorTier": "declarative",
        "steps": [
          { "kind": "rename_field", "path": [], "from": "does_not_exist", "to": "renamed" }
        ]
      },
      "input": { "body": "buy milk" },
      "expected": {
        "ok": false,
        "outcome": "migration_failed",
        "reason": "field_not_found",
        "recommendedAction": "restore_prior_snapshot"
      }
    },
    {
      "id": "unshipped_executor_tier_installed_but_incompatible",
      "description": "A migration honestly declares the 'restricted' executor tier, which has not shipped in Stage 2. It must resolve to installed-but-incompatible rather than silently running under the declarative interpreter (PLUG-D20).",
      "migration": {
        "executorTier": "restricted",
        "steps": [
          { "kind": "drop_field", "path": [], "field": "anything" }
        ]
      },
      "input": { "anything": 1 },
      "expected": {
        "ok": false,
        "outcome": "installed_but_incompatible",
        "reason": "executor_tier_not_shipped_or_disabled",
        "recommendedAction": "retain_prior_generation"
      }
    },
    {
      "id": "disabled_declarative_tier_installed_but_incompatible",
      "description": "Even the declarative tier itself can be disabled by policy; a migration declaring it must still fail closed rather than run.",
      "migration": { "executorTier": "declarative", "steps": [] },
      "input": {},
      "enabledExecutorTiers": [],
      "expected": {
        "ok": false,
        "outcome": "installed_but_incompatible",
        "reason": "executor_tier_not_shipped_or_disabled",
        "recommendedAction": "retain_prior_generation"
      }
    },
    {
      "id": "unknown_executor_tier_installed_but_incompatible",
      "description": "A migration naming an executor tier outside the closed vocabulary is never guessed at -- it fails closed.",
      "migration": { "executorTier": "javascript_vm", "steps": [] },
      "input": {},
      "expected": {
        "ok": false,
        "outcome": "installed_but_incompatible",
        "reason": "unknown_executor_tier",
        "recommendedAction": "retain_prior_generation"
      }
    },
    {
      "id": "full_host_tier_never_falls_back_to_declarative",
      "description": "full_host is a real, known tier, and this interpreter structurally never executes it (this module IS the declarative host, not a dispatcher).",
      "migration": {
        "executorTier": "full_host",
        "steps": [{ "kind": "drop_field", "path": [], "field": "x" }]
      },
      "input": { "x": 1 },
      "enabledExecutorTiers": ["declarative", "restricted", "full_host"],
      "expected": {
        "ok": false,
        "outcome": "installed_but_incompatible",
        "reason": "executor_tier_requires_different_host",
        "recommendedAction": "retain_prior_generation"
      }
    },
    {
      "id": "wrap_then_unwrap_round_trip",
      "description": "wrap_object followed by unwrap_object on the same field returns the original shape, proving the pair is a true round trip and not lossy.",
      "migration": {
        "executorTier": "declarative",
        "steps": [
          { "kind": "wrap_object", "path": [], "field": "address", "into": "legacy" },
          { "kind": "unwrap_object", "path": [], "field": "address", "from": "legacy" }
        ]
      },
      "input": { "address": "221B Baker Street" },
      "expected": {
        "ok": true,
        "value": { "address": "221B Baker Street" }
      }
    },
    {
      "id": "drop_field_missing_field_is_a_safe_noop",
      "description": "Dropping a field that is already absent cannot lose data, so it succeeds as a no-op rather than failing the migration.",
      "migration": {
        "executorTier": "declarative",
        "steps": [{ "kind": "drop_field", "path": [], "field": "never_existed" }]
      },
      "input": { "keep": 1 },
      "expected": {
        "ok": true,
        "value": { "keep": 1 }
      }
    },
    {
      "id": "set_default_never_overwrites_existing_value",
      "description": "set_default only fills in a value when the field is absent; an existing (possibly user-written) value is never clobbered.",
      "migration": {
        "executorTier": "declarative",
        "steps": [{ "kind": "set_default", "path": [], "field": "pinned", "value": false }]
      },
      "input": { "pinned": true },
      "expected": {
        "ok": true,
        "value": { "pinned": true }
      }
    },
    {
      "id": "unmapped_enum_value_fails_closed",
      "description": "An enum value not covered by the migration's declared mapping is a defect in the migration, not something to pass through silently.",
      "migration": {
        "executorTier": "declarative",
        "steps": [{ "kind": "map_enum_value", "path": [], "field": "status", "mapping": { "todo": "open" } }]
      },
      "input": { "status": "archived" },
      "expected": {
        "ok": false,
        "outcome": "migration_failed",
        "reason": "unmapped_enum_value",
        "recommendedAction": "restore_prior_snapshot"
      }
    },
    {
      "id": "step_count_budget_exceeded",
      "description": "A migration with more steps than the injected limit fails closed before applying any of them.",
      "migration": {
        "executorTier": "declarative",
        "steps": [
          { "kind": "drop_field", "path": [], "field": "a" },
          { "kind": "drop_field", "path": [], "field": "b" },
          { "kind": "drop_field", "path": [], "field": "c" }
        ]
      },
      "input": { "a": 1, "b": 2, "c": 3 },
      "limits": { "maxSteps": 2 },
      "expected": {
        "ok": false,
        "outcome": "migration_failed",
        "reason": "step_count_exceeded",
        "recommendedAction": "restore_prior_snapshot"
      }
    },
    {
      "id": "unknown_step_kind_fails_closed",
      "description": "A step naming a kind outside the closed vocabulary (e.g. an attempted escape hatch) is never interpreted as code -- it fails closed.",
      "migration": {
        "executorTier": "declarative",
        "steps": [{ "kind": "eval_javascript", "code": "1+1" }]
      },
      "input": {},
      "expected": {
        "ok": false,
        "outcome": "migration_failed",
        "reason": "unknown_step_kind",
        "recommendedAction": "restore_prior_snapshot"
      }
    },
    {
      "id": "path_depth_budget_exceeded",
      "description": "A step whose container path is deeper than the injected recursion bound is rejected rather than walked.",
      "migration": {
        "executorTier": "declarative",
        "steps": [{ "kind": "drop_field", "path": ["a", "b", "c"], "field": "x" }]
      },
      "input": { "a": { "b": { "c": { "x": 1 } } } },
      "limits": { "maxPathDepth": 1 },
      "expected": {
        "ok": false,
        "outcome": "migration_failed",
        "reason": "path_not_found",
        "recommendedAction": "restore_prior_snapshot"
      }
    }
  ]
}
