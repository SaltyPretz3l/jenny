    {
      "name": "posix_paths_are_redacted_like_drive_letter_paths",
      "input": {
        "v": 1,
        "turn_id": "turn_path_parity",
        "stream_id": "stream_path_parity",
        "session_id": "session_path_parity",
        "seq": 1,
        "type": "tool_input_delta",
        "tool_call_id": "call_read_posix",
        "payload": {
          "tool_name": "read_file",
          "arguments_delta": "{\"path\":\"/Users/example/secret.txt\",\"key\":\"/home/gosh/.ssh/id_rsa\"}",
          "input": {
            "log": "/var/log/app.log",
            "note": "opened /Users/example/Desktop/plan.md today"
          }
        }
      },
      "expected": {
        "status": "accepted",
        "durability": "ephemeral",
        "persisted_kind": null,
        "part_kind": "tool_part",
        "part_state": "input_streaming",
        "redacted_substrings_absent": [
          "/Users/example/secret.txt",
          "/home/gosh/.ssh/id_rsa",
          "/var/log/app.log",
          "/Users/example/Desktop/plan.md"
        ],
        "redacted_substrings_present": [
          "[redacted:path]/secret.txt",
          "[redacted:path]/id_rsa",
          "[redacted:path]/app.log",
          "[redacted:path]/plan.md"
        ]
      }
    },
    {
      "name": "file_urls_redact_on_both_platforms_and_http_urls_stay_legible",
      "input": {
        "v": 1,
        "turn_id": "turn_path_parity",
        "seq": 2,
        "type": "tool_call_requested",
        "tool_call_id": "call_fetch",
        "payload": {
          "tool_name": "fetch",
          "tool_input_summary": "open file:///Users/example/notes.md and file:///C:/Users/example/notes.md then https://example.com/docs/page?q=1"
        }
      },
      "expected": {
        "status": "accepted",
        "event_id": "turn_path_parity:canonical:2",
        "part_id": "turn_path_parity:tool_part:2",
        "durability": "durable",
        "persisted_kind": "tool_use",
        "part_kind": "tool_part",
        "part_state": "pending",
        "redacted_substrings_absent": [
          "file:///Users/example/notes.md",
          "file:///C:/Users/example/notes.md",
          "/Users/example/notes.md"
        ],
        "redacted_substrings_present": [
          "file:///[redacted:path]/notes.md",
          "https://example.com/docs/page?q=1"
        ]
      }
    },
    {
      "name": "assistant_text_code_and_routes_survive_root_anchored_path_redaction",
      "input": {
        "v": 1,
        "turn_id": "turn_path_parity",
        "seq": 3,
        "type": "text_delta",
        "payload": {
          "delta": "Register app.get('/api/users', handler) then GET /api/users/42 — config lives in /Users/example/.config/app.toml"
        }
      },
      "expected": {
        "status": "accepted",
        "durability": "ephemeral",
        "persisted_kind": null,
        "part_kind": "text_part",
        "part_state": "streaming",
        "redacted_substrings_absent": [
          "/Users/example/.config/app.toml"
        ],
        "redacted_substrings_present": [
          "app.get('/api/users', handler)",
          "GET /api/users/42",
          "[redacted:path]/app.toml"
        ]
      }
    },
