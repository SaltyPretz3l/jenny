{
  "schema_version": 1,
  "cases": [
    {
      "name": "tool_input_delta_is_ephemeral_and_redacted",
      "input": {
        "v": 1,
        "turn_id": "turn_packet_0",
        "stream_id": "stream_packet_0",
        "session_id": "session_packet_0",
        "seq": 1,
        "type": "tool_input_delta",
        "tool_call_id": "call_read",
        "payload": {
          "tool_name": "read_file",
          "arguments_delta": "{\"path\":\"G:/Users/example/secret.txt\",\"token\":\"sk-test-secret\"}",
          "provider_metadata": {
            "raw": "do not keep"
          }
        }
      },
      "expected": {
        "status": "accepted",
        "durability": "ephemeral",
        "persisted_kind": null,
        "part_kind": "tool_part",
        "part_state": "input_streaming",
        "redacted_substrings_absent": [
          "G:/Users/example/secret.txt",
          "sk-test-secret",
          "do not keep"
        ]
      }
    },
    {
      "name": "tool_call_requested_is_durable",
      "input": {
        "v": 1,
        "turn_id": "turn_packet_0",
        "seq": 2,
        "type": "tool_call_requested",
        "tool_call_id": "call_read",
        "payload": {
          "tool_name": "read_file",
          "tool_input_summary": "Read workspace file",
          "input": {
            "path": "renderer/app.js"
          }
        }
      },
      "expected": {
        "status": "accepted",
        "event_id": "turn_packet_0:canonical:2",
        "part_id": "turn_packet_0:tool_part:2",
        "durability": "durable",
        "persisted_kind": "tool_use",
        "part_kind": "tool_part",
        "part_state": "pending"
      }
    },
