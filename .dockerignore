# Deny the entire build context, then admit only application source inputs.
*
!package.json
!package-lock.json
!reasoning-effort-profiles.js
!renderer
!renderer/browser
!renderer/browser/**
!renderer/shared
!renderer/shared/**
!renderer/chat
!renderer/chat/**
!renderer/features
!renderer/features/renderer-plan-document.js
!renderer/inventory
!renderer/inventory/**
!renderer/features
!renderer/features/renderer-plan-document.js
!locales
!locales/*.json
!services
!services/**
!sidecar
!sidecar/**
!server
!server/**
!scripts
!scripts/build-browser.js
!config
!config/host.example.json
!config/chat-lifecycle-v2.schema.json
!config/workspace-mutation-journal-v1.schema.json
!config/model-recommendation-catalog.json
!config/model-acceleration-catalog.json
!config/llama-server-runtime.json
!config/ollama-install-manifest.json
!config/llama-server-profiles
!config/llama-server-profiles/**
!config/plugins
!config/plugins/**
# Denials after inclusions also cover accidentally copied local material.
**/secrets
**/.env
**/.env.*
**/*.pem
**/*.key
**/__pycache__
**/*.pyc
**/*.test.js
**/*.log
**/.DS_Store
tests
plugins
