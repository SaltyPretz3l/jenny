  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Identity token: 1-128 chars of [A-Za-z0-9_.:-]."
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Decision-request reference (approval id, question ref, plan approval id): 1-512 chars, no control characters. Never clipped: an over-long ref drops the event instead."
    },
    "call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "description": "Provider tool-call id: 1-256 chars, no control characters."
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Tool name: 1-128 chars of [A-Za-z0-9_.:-]."
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "description": "Short machine reason or status token: 1-64 chars of [A-Za-z0-9_.:-]."
    },
    "cmp_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^CMP-[A-Z]+(-[A-Z0-9]+)+$",
      "description": "CMP-<DOMAIN>-<NNNN> error code, at most 64 chars."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Non-negative safe integer."
    },
    "summary_text": {
      "type": "string",
      "maxLength": 512,
      "description": "Human summary line, clipped to 512 chars."
    },
    "delta_text": {
      "type": "string",
      "maxLength": 65536,
      "description": "One assistant text delta, clipped to 65536 chars."
    },
    "thinking_text": {
      "type": "string",
      "maxLength": 16384,
      "description": "One reasoning delta, clipped to 16384 chars."
    },
    "tool_result_text": {
      "type": "string",
      "maxLength": 16384,
      "description": "Tool result body, clipped to 16384 chars."
    },
    "output_line_text": {
      "type": "string",
      "maxLength": 4000,
      "description": "One tool output line, clipped to 4000 chars."
    },
    "message_text": {
      "type": "string",
      "maxLength": 2000,
      "description": "Error or status message, clipped to 2000 chars."
    },
    "result_text": {
      "type": "string",
      "maxLength": 262144,
      "description": "Final result text, clipped to 262144 chars."
    },
    "version_text": {
      "type": "string",
      "maxLength": 64,
      "description": "Version string, at most 64 chars."
    },
    "model_text": {
      "type": "string",
      "maxLength": 256,
      "description": "Model or engine name, at most 256 chars."
    },
    "cwd_text": {
      "type": "string",
      "maxLength": 4096,
      "description": "Working directory, at most 4096 chars."
    },
    "question_prompt_text": {
      "type": "string",
      "maxLength": 2000,
      "description": "Question prompt, clipped to 2000 chars."
    },
    "option_text": {
      "type": "string",
      "maxLength": 256,
      "description": "Answer option label, clipped to 256 chars."
    },
    "plan_title_text": {
      "type": "string",
      "maxLength": 200,
      "description": "Plan title, clipped to 200 chars."
    },
    "plan_summary_text": {
      "type": "string",
      "maxLength": 2000,
      "description": "Plan summary, clipped to 2000 chars."
    },
    "plan_step_text": {
      "type": "string",
      "maxLength": 500,
      "description": "One plan step, clipped to 500 chars."
    },
    "work_status": {
      "type": "string",
      "enum": [
        "pending",
        "paused",
        "running",
        "completed",
        "failed",
        "cancelled",
        "needs_attention"
      ],
      "description": "Durable runtime work status (services/session-runtime/contracts.js WORK_STATUSES)."
    },
    "discard_scope": {
      "type": "string",
      "enum": [
        "all",
        "live_slice",
        "none"
      ],
      "description": "What a reset erased: all = every text segment of the turn; live_slice = only the unsaved slice since the last tool boundary; none = nothing."
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "tool_cap",
        "max_iterations",
        "diminishing_returns",
        "context_budget"
      ],
      "description": "Resumable stop reported by the turn."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Token usage.",
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "$ref": "#/definitions/count"
        },
        "output_tokens": {
          "$ref": "#/definitions/count"
        },
        "total_tokens": {
          "$ref": "#/definitions/count"
        },
        "estimated": {
          "type": "boolean"
        }
      }
    },
    "tool_list": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/definitions/tool_name"
      },
      "description": "At most 256 tool names."
    },
    "optional_limit": {
      "anyOf": [
        {
          "$ref": "#/definitions/count"
        },
        {
          "type": "null"
        }
      ],
      "description": "A budget value; null means unlimited."
    },
    "decision_request": {
      "type": "string",
      "enum": [
        "tool_approval",
        "user_questions",
        "plan_proposal"
      ]
    },
    "decision_by": {
      "type": "string",
      "enum": [
        "policy",
        "user",
        "caller"
      ]
    },
    "payload_init": {
      "type": "object",
      "additionalProperties": false,
      "description": "Run configuration, echoed before any work is submitted.",
      "required": [
        "versions",
        "cwd",
        "model",
        "engine",
        "permission_mode",
        "allowed_tools",
        "budgets"
      ],
      "properties": {
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cli",
            "contract"
          ],
          "properties": {
            "cli": {
              "$ref": "#/definitions/version_text"
            },
            "contract": {
              "const": "cli.v1"
            },
            "app": {
              "$ref": "#/definitions/version_text"
            },
            "sidecar_api": {
              "$ref": "#/definitions/version_text"
            }
          }
        },
        "cwd": {
          "$ref": "#/definitions/cwd_text"
        },
        "model": {
          "$ref": "#/definitions/model_text"
        },
        "engine": {
          "$ref": "#/definitions/model_text"
        },
        "permission_mode": {
          "type": "string",
          "enum": [
            "ask",
            "auto",
            "plan"
          ]
        },
        "allowed_tools": {
          "$ref": "#/definitions/tool_list"
        },
        "disallowed_tools": {
          "$ref": "#/definitions/tool_list"
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_turns",
