          "type": "boolean"
        },
        "message": {
          "$ref": "#/definitions/message_text"
        },
        "category": {
          "$ref": "#/definitions/token"
        }
      }
    },
    "payload_result": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one final frame per run.",
      "required": [
        "subtype",
        "is_error",
        "exit_code",
        "session_id",
        "result",
        "usage",
        "num_turns",
        "duration_ms",
        "permission_denials"
      ],
      "properties": {
        "subtype": {
          "type": "string",
          "enum": [
            "success",
            "denied",
            "input_required",
            "budget",
            "cancelled",
            "error"
          ]
        },
        "is_error": {
          "type": "boolean"
        },
        "exit_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            6,
            75,
            130,
            143
          ]
        },
        "session_id": {
          "$ref": "#/definitions/id"
        },
        "result": {
          "$ref": "#/definitions/result_text"
        },
        "truncated": {
          "const": true
        },
        "usage": {
          "$ref": "#/definitions/usage"
        },
        "num_turns": {
          "$ref": "#/definitions/count"
        },
        "duration_ms": {
          "$ref": "#/definitions/count"
        },
        "permission_denials": {
          "type": "array",
          "maxItems": 64,
          "description": "At most 64 denials.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "request",
              "by"
            ],
            "properties": {
              "ref": {
                "$ref": "#/definitions/ref"
              },
              "request": {
                "$ref": "#/definitions/decision_request"
              },
              "by": {
                "$ref": "#/definitions/decision_by"
              },
              "rule": {
                "$ref": "#/definitions/summary_text"
              },
              "call_id": {
                "$ref": "#/definitions/call_id"
              },
              "tool_name": {
                "$ref": "#/definitions/tool_name"
              }
            }
          }
        },
        "resumable_stop": {
          "type": "object",
          "additionalProperties": false,
