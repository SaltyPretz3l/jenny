          "required": [
            "reason"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "tool_cap",
                "max_iterations",
                "diminishing_returns",
                "context_budget",
                "runtime_budget",
                "timeout",
                "paused"
              ]
            },
            "work_id": {
              "$ref": "#/definitions/id"
            }
          }
        },
        "error_code": {
          "$ref": "#/definitions/cmp_code"
        }
      }
    }
  }
}
