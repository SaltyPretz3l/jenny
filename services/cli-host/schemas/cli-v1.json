        "ref",
        "call_id",
        "title",
        "steps"
      ],
      "properties": {
        "ref": {
          "$ref": "#/definitions/ref"
        },
        "plan_id": {
          "$ref": "#/definitions/id"
        },
        "call_id": {
          "$ref": "#/definitions/call_id"
        },
        "title": {
          "$ref": "#/definitions/plan_title_text"
        },
        "summary": {
          "$ref": "#/definitions/plan_summary_text"
        },
        "steps": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/plan_step_text"
          },
