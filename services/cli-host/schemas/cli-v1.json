      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "$ref": "#/definitions/ref"
        },
        "call_id": {
          "$ref": "#/definitions/call_id"
        },
        "reason": {
          "$ref": "#/definitions/token"
        }
      }
    },
