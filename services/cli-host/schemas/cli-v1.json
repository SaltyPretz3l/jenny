            "max_inference_requests",
            "timeout_ms"
          ],
          "properties": {
            "max_turns": {
              "$ref": "#/definitions/optional_limit"
            },
            "max_output_tokens": {
              "$ref": "#/definitions/optional_limit"
            },
            "max_inference_requests": {
              "$ref": "#/definitions/optional_limit"
            },
            "timeout_ms": {
              "$ref": "#/definitions/optional_limit"
            }
          }
        }
      }
    },
    "payload_accepted": {
      "type": "object",
      "additionalProperties": false,
      "description": "Durable acceptance; precedes any stream id.",
      "required": [
        "user_message_id",
        "idempotency_key",
        "retry_point"
      ],
      "properties": {
        "user_message_id": {
          "$ref": "#/definitions/id"
        },
        "idempotency_key": {
          "$ref": "#/definitions/id"
        },
        "retry_point": {
          "type": "object",
          "additionalProperties": false,
          "description": "Durable work record at acceptance. Resubmitting with the same idempotency_key is deduplicated by the runtime; revision lets a caller detect progress since acceptance.",
          "required": [
            "revision",
            "status"
          ],
          "properties": {
            "revision": {
              "$ref": "#/definitions/count"
            },
            "status": {
              "$ref": "#/definitions/work_status"
            }
          }
        }
      }
    },
