          "$ref": "#/definitions/call_id"
        },
        "reason": {
          "$ref": "#/definitions/token"
        }
      }
    },
    "payload_plan_proposed": {
      "type": "object",
      "additionalProperties": false,
      "description": "A plan waits for an accept/reject decision.",
