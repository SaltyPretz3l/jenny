          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prompt",
              "options"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "prompt": {
                "$ref": "#/definitions/question_prompt_text"
              },
              "options": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "$ref": "#/definitions/option_text"
                }
              },
