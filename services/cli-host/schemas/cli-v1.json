      "type": "object",
      "additionalProperties": false,
      "description": "The turn completed.",
      "required": [],
      "properties": {
        "usage": {
          "$ref": "#/definitions/usage"
        },
        "resumable_stop": {
          "$ref": "#/definitions/stop_reason"
        },
