          "type": "string",
          "enum": [
            "awaiting_proposal",
            "session_handoff_completed"
          ]
        }
      }
    },
    "payload_error": {
      "type": "object",
      "additionalProperties": false,
      "description": "The turn failed.",
      "required": [
