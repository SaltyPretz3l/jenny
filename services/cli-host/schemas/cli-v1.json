          "$ref": "#/definitions/decision_by"
        },
        "rule": {
          "$ref": "#/definitions/summary_text"
        },
        "call_id": {
          "$ref": "#/definitions/call_id"
        },
        "tool_name": {
          "$ref": "#/definitions/tool_name"
        }
      }
    },
    "payload_status": {
      "type": "object",
      "additionalProperties": false,
      "description": "Work-record transitions and engine progress lines.",
      "required": [
        "phase"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "work",
            "progress",
            "context_compacted"
          ]
        },
        "work_status": {
          "$ref": "#/definitions/work_status"
        },
        "revision": {
          "$ref": "#/definitions/count"
        },
        "text": {
          "$ref": "#/definitions/message_text"
        }
      }
    },
